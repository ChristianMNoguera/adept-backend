{
  "name": "conversational-agent",
  "version": "0.1.0",
  "description": "Agente conversacional de ADEPT (por ahora solo con respuestas mock)",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/contract-smoke.js",
    "test": "tsc && node scripts/run-tests.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "@codegenie/serverless-express": "5.0.0",
    "aws-jwt-verify": "5.2.1",
    "cors": "2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-openapi-validator": "5.6.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "js-yaml": "5.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
