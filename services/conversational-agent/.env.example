# Copiá este archivo como ".env" y ajustá los valores.

# Puerto donde escucha el servidor.
PORT=3000

# "mock"   = responde con datos fijos (los del contrato openapi.yaml).
# "hybrid" = cada operación usa la lógica real si está implementada y el mock si no
#            (necesita CORE_TABLE y TEXT_TABLE, de abajo).
# "real"   = solo responden las operaciones con lógica real; el resto da 501.
DATA_SOURCE=mock

# Solo con DATA_SOURCE=hybrid o real: nombres de las tablas de DynamoDB (salidas CoreTableName
# y TextTableName de la infraestructura) y vida del texto de los mensajes en horas (72 por defecto).
# CORE_TABLE=adept-dev-core
# TEXT_TABLE=adept-dev-text
# TEXT_TTL_HOURS=72

# Orígenes permitidos por CORS, separados por comas (los necesita el panel web).
# Si no se define, se permite cualquier origen, pero solo con DATA_SOURCE=mock.
CORS_ORIGINS=http://localhost:5173

# Cómo se identifica al usuario:
#   "mock"    = por headers de prueba x-mock-role / x-mock-user-id (valor por defecto).
#   "cognito" = se verifica el token de acceso de Amazon Cognito (necesita las 2 variables de abajo).
AUTH_MODE=mock

# Solo con AUTH_MODE=cognito. Los valores salen de las salidas de la infraestructura (ver infra/README.md).
# USER_POOL_ID=sa-east-1_XXXXXXXXX
# COGNITO_CLIENT_IDS=idDelClienteMovil,idDelClienteWeb

# Ruta al contrato OpenAPI. Si no se define, se usa contracts/openapi.yaml del repo.
# (En la Lambda la define la infraestructura.)
# OPENAPI_SPEC_PATH=
